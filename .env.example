# Copia este archivo como .env y pon tus credenciales de Supabase
# (https://supabase.com) — son gratis para empezar.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Client ID público de una app creada en https://developer.spotify.com/dashboard
# Añade la URL pública HTTPS de Habits y http://127.0.0.1:5173/ como Redirect URIs.
# PKCE no requiere ni permite guardar el Client Secret en el navegador.
VITE_SPOTIFY_CLIENT_ID=

# Los secretos de Mercado Pago NO van en este archivo Vite.
# Configúralos con `supabase secrets set`; consulta README.md.
